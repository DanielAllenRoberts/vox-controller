# Vox Controller — environment variable template.
# Copy to .env and fill in. The real .env is gitignored — never commit secrets.
# Nothing here is required yet; API keys are only needed once the AI layer lands (M4).

# --- AI providers (provider-agnostic — fill only what you use; see config.llm_provider) ---
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# --- Optional cloud TTS (only if you opt into a cloud voice) ---
ELEVENLABS_API_KEY=
